DELIMITER $$

CREATE TRIGGER after_item_insert
AFTER INSERT ON items
FOR EACH ROW
UPDATE categories SET item_count = item_count + 1
WHERE name = NEW.category$$

CREATE TRIGGER after_item_delete
AFTER DELETE ON items
FOR EACH ROW
UPDATE categories SET item_count = item_count - 1
WHERE name = OLD.category$$

DELIMITER ;